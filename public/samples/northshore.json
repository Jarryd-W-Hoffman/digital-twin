{
  "id": "northshore",
  "name": "Northshore Cold Chain Hub",
  "description": "A fictional refrigerated logistics campus with rooftop solar, a battery and backup generation.",
  "origin": { "lon": 153.0812, "lat": -27.4405 },
  "utcOffsetHours": 10,
  "climate": { "meanC": 26, "swingC": 5 },
  "camera": { "headingDeg": 28, "pitchDeg": -17, "rangeM": 900 },
  "tariff": {
    "offPeakPerKwh": 0.14, "peakPerKwh": 0.38, "peakStartHour": 16, "peakEndHour": 21,
    "dieselPerLitre": 1.95, "gridKgCo2PerKwh": 0.71, "dieselKgCo2PerLitre": 2.68
  },
  "tilesets": [{ "id": "context", "name": "Neighbouring buildings", "url": "/tilesets/context/tileset.json" }],
  "types": [
    {
      "id": "water-tank", "name": "Fire water tank", "primary": "levelPct",
      "metrics": [
        { "key": "levelPct", "label": "Level", "unit": "%", "decimals": 0, "default": 92 },
        { "key": "pressureKpa", "label": "Ring main pressure", "unit": "kPa", "decimals": 0, "default": 710,
          "expr": "clamp(pressureKpa + ({jockey.powerKw} > 0 ? 12 : -1.5) * dt / 60, 0, 900)" }
      ],
      "visual": { "color": "#3a7ca5", "shape": "cylinder", "height": 9 }
    },
    {
      "id": "jockey-pump", "name": "Jockey pump", "primary": "powerKw",
      "metrics": [
        { "key": "powerKw", "label": "Power", "unit": "kW", "decimals": 1, "expr": "running ? 7.5 : 0" },
        { "key": "runMin", "label": "Running for", "unit": "min", "decimals": 0, "expr": "running ? runMin + dt / 60 : 0" },
        { "key": "startKpa", "label": "Start below", "unit": "kPa", "default": 650, "setpoint": { "min": 550, "max": 720, "step": 10 } },
        { "key": "stopKpa", "label": "Stop above", "unit": "kPa", "default": 740, "setpoint": { "min": 680, "max": 820, "step": 10 } }
      ],
      "states": [
        { "id": "idle", "label": "Idle", "status": "standby" },
        { "id": "running", "label": "Running", "status": "running" }
      ],
      "transitions": [
        { "from": "idle", "to": "running", "when": "{fire-tank.pressureKpa} < startKpa && powered" },
        { "from": "running", "to": "idle", "when": "{fire-tank.pressureKpa} >= stopKpa || !powered" }
      ],
      "visual": { "color": "#5b8fb9", "shape": "box", "height": 3 }
    }
  ],
  "zones": [
    { "id": "cold", "name": "Cold storage", "footprint": [[-150,-60],[60,-60],[60,110],[-150,110]] },
    { "id": "plant", "name": "Plant yard", "footprint": [[60,-60],[150,-60],[150,110],[60,110]] },
    { "id": "energy", "name": "Energy yard", "footprint": [[60,-190],[230,-190],[230,-70],[60,-70]] },
    { "id": "logistics", "name": "Logistics apron", "footprint": [[-150,-190],[50,-190],[50,-70],[-150,-70]] },
    { "id": "admin", "name": "Administration", "footprint": [[-250,-60],[-160,-60],[-160,110],[-250,110]] }
  ],

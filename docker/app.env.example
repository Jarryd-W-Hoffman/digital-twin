# Settings for the app's own .env (in the project root) when it runs in this
# stack. Hostnames are compose service names, not localhost.
APP_URL=http://localhost:8085

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# Uploaded models and tilesets in RustFS.
MERIDIAN_ASSETS_DISK=s3
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=meridian
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Browsers upload library files straight to RustFS, at its forwarded port.
MERIDIAN_DIRECT_UPLOADS=true
MERIDIAN_DIRECT_UPLOADS_ENDPOINT=http://localhost:9014

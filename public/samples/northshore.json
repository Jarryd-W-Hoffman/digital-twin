    { "id": "agv-2", "name": "Yard AGV 2", "kind": "vehicle", "zone": "cold", "route": "dock-shuttle",
      "params": { "speedMps": 2.4, "startFrac": 0.6, "drainPctPerKm": 2.5, "batteryKwh": 40, "initialBatteryPct": 73 } }
  ],
  "routes": [
    { "id": "apron-loop", "name": "Apron loop",
      "path": [[-100,-156],[40,-156],[50,-125],[40,-122],[-135,-122],[-145,-140],[-145,-160]],
      "stops": [{ "at": 3, "dwellS": 900 }, { "at": 0, "dwellS": 1500, "charger": "ev-hub" }] },
    { "id": "dock-shuttle", "name": "Dock shuttle",
      "path": [[-130,-50],[48,-50],[48,-72],[-130,-72]],
      "stops": [{ "at": 1, "dwellS": 240 }, { "at": 3, "dwellS": 300, "charger": "agv-dock" }] }
  ],
  "rules": [
    { "id": "jockey-long-run", "name": "Jockey pump running long", "severity": "warning", "asset": "jockey", "when": "running && runMin > 20", "message": "{asset} has run for 20 minutes: check the ring main for a leak" },
    { "id": "freezer-warming-fast", "name": "Freezer warming fast", "severity": "warning", "asset": "freezer", "metric": "tempC", "change": { "overS": 600 }, "op": "gt", "threshold": 2, "message": "{asset} has warmed 2 °C in ten minutes" },
    { "id": "fire-water-low", "name": "Fire water low", "severity": "warning", "asset": "fire-tank", "metric": "levelPct", "op": "lt", "threshold": 60, "clearAt": 65, "message": "{asset} is below 60%" },
    { "id": "store-warm", "name": "Store above temperature limit", "severity": "critical", "kind": "coldstore", "metric": "excursionMin", "op": "gt", "threshold": 0.5, "clearAt": 0, "message": "{asset} is above its temperature limit" },
    { "id": "freezer-drift", "name": "Freezer drifting warm", "severity": "warning", "asset": "freezer", "metric": "tempC", "op": "gt", "threshold": -18, "forS": 300, "clearAt": -18.6, "message": "{asset} is drifting above -18 °C" },
    { "id": "chill-drift", "name": "Chill room drifting warm", "severity": "warning", "asset": "chillroom", "metric": "tempC", "op": "gt", "threshold": 5.5, "forS": 300, "clearAt": 4.8, "message": "{asset} is drifting above 5.5 °C" },
    { "id": "stock-risk", "name": "Stock at risk", "severity": "critical", "kind": "coldstore", "metric": "atRiskT", "op": "gt", "threshold": 0, "message": "Stock in {asset} is at risk" },
    { "id": "chiller-vibration", "name": "Bearing wear", "severity": "warning", "kind": "chiller", "metric": "vibrationMms", "op": "gt", "threshold": 3.2, "forS": 600, "clearAt": 2.8, "message": "{asset} vibration points to bearing wear" },
    { "id": "chiller-fault", "name": "Chiller tripped", "severity": "critical", "kind": "chiller", "metric": "state", "op": "gt", "threshold": 3.5, "clearAt": 3.5, "message": "{asset} has tripped" },
    { "id": "board-fault", "name": "Switchboard tripped", "severity": "critical", "kind": "bus", "metric": "state", "op": "gt", "threshold": 3.5, "clearAt": 3.5, "message": "{asset} has tripped" },
    { "id": "grid-lost", "name": "Grid lost", "severity": "critical", "asset": "site", "metric": "islanded", "op": "gt", "threshold": 0.5, "clearAt": 0.5, "message": "Grid supply lost; the site is islanded" },
    { "id": "unserved", "name": "Load not served", "severity": "critical", "asset": "site", "metric": "unservedKw", "op": "gt", "threshold": 1, "forS": 60, "clearAt": 1, "message": "Site is not serving all of its load" },
    { "id": "batt-low", "name": "Battery low", "severity": "warning", "kind": "battery", "metric": "socPct", "op": "lt", "threshold": 20, "clearAt": 26, "message": "{asset} is below 20%" },
    { "id": "fuel-low", "name": "Fuel low", "severity": "warning", "kind": "genset", "metric": "fuelPct", "op": "lt", "threshold": 25, "clearAt": 30, "message": "{asset} fuel is below 25%" },
    { "id": "veh-flat", "name": "Vehicle low on charge", "severity": "warning", "kind": "vehicle", "metric": "batteryPct", "op": "lt", "threshold": 10, "clearAt": 20, "message": "{asset} is low on charge" }
  ],
  "scenarios": [
    { "id": "grid-outage", "name": "Grid outage, 4 hours", "description": "The network feeder drops; the battery bridges to the generator.",
      "faults": [{ "type": "grid-outage", "durationS": 14400 }] },
    { "id": "blackout", "name": "Outage, generator fails", "description": "Grid loss with a failed generator start: the battery carries the site alone.",
      "faults": [{ "type": "grid-outage", "durationS": 28800 }, { "type": "genset-fail", "durationS": 28800 }] },
    { "id": "chiller-trip", "name": "Chiller 1 trips", "description": "One of the two freezer chillers goes offline until cleared.",
      "faults": [{ "type": "trip", "target": "ch-1" }] },
    { "id": "board-trip", "name": "Refrigeration board trips", "description": "A breaker opens upstream of all three chillers.",
      "faults": [{ "type": "trip", "target": "db-cold" }] },
    { "id": "door-stuck", "name": "Freezer door stuck open", "description": "The main freezer door fails open during a shift.",
      "faults": [{ "type": "door-stuck", "target": "freezer", "durationS": 7200 }] },
    { "id": "heatwave", "name": "Heatwave, +11 °C", "description": "Hot air robs the chillers of both capacity and efficiency.",
      "faults": [{ "type": "heatwave", "magnitude": 11 }] },
    { "id": "bearing", "name": "Bearing wear, Chiller 2", "description": "Slow mechanical wear that shows up in vibration before it costs efficiency.",
      "faults": [{ "type": "bearing-wear", "target": "ch-2", "magnitude": 0.6 }] }
  ],
  "panels": [
    {
      "title": "Fire protection",
      "chart": { "label": "Ring main pressure", "value": "{fire-tank.pressureKpa}", "unit": "kPa" },
      "items": [
        { "label": "Tank level", "value": "{fire-tank.levelPct}", "unit": "%" },
        { "label": "Jockey pump", "value": "{jockey.powerKw}", "unit": "kW", "decimals": 1 },
        { "label": "Pressure in hand", "value": "{fire-tank.pressureKpa} - {jockey.startKpa}", "unit": "kPa" }
      ]
    }
  ],
  "shapes": [
    { "id": "wind", "name": "Wind", "kind": "vector", "asset": "wx", "height": 2, "heading": "{wx.windDeg} + 180", "length": "{wx.windMs} * 6" },
    { "id": "yard-camera", "name": "Yard camera", "kind": "fan", "position": [10, -112], "height": 9.5, "heading": "215", "tilt": "-20", "radius": 70, "across": 70, "up": 40 }
  ]
}

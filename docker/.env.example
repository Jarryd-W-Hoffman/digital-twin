# Path to the Meridian app, relative to this file (the bind-mount source).
APP_CODE_PATH=..
# Prefixes container, volume and network names.
COMPOSE_PROJECT_NAME=meridian

# Host ports, offset so this stack runs alongside other local stacks.
FORWARD_APP_PORT=8085
FORWARD_GATEWAY_PORT=8788
FORWARD_DB_PORT=5436
FORWARD_REDIS_PORT=6385
FORWARD_MAILPIT_PORT=1030
FORWARD_MAILPIT_DASHBOARD_PORT=8030
FORWARD_RUSTFS_PORT=9014
FORWARD_RUSTFS_CONSOLE_PORT=9015

# Postgres; must match DB_* in the app's .env.
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=secret

# RustFS; must match AWS_* in the app's .env.
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=meridian

# Issued in a twin's Layout panel under Gateway. Needed by the gateway profile.
MERIDIAN_GATEWAY_TOKEN=

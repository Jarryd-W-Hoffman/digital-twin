    { "id": "truck-2", "name": "E-truck 2", "kind": "vehicle", "zone": "logistics", "route": "apron-loop",
      "params": { "speedMps": 6, "startFrac": 0.45, "drainPctPerKm": 12, "batteryKwh": 280, "initialBatteryPct": 64 } },
    { "id": "truck-3", "name": "E-truck 3", "kind": "vehicle", "zone": "logistics", "route": "apron-loop",

#!/usr/bin/env python3
"""
Tiles a digital elevation model (GeoTIFF, ASCII grid, anything GDAL reads)
as Cesium quantized-mesh terrain:

    reproject to WGS84 longitude and latitude
    fill its gaps (under trees, around buildings) from the ground around
    them, and note the height of its edges, then build overviews
    pick the deepest zoom from the DEM's resolution
    for each zoom, for each tile in the geographic TMS that covers the DEM
    (and both whole-hemisphere tiles at zoom 0, so the globe is complete):
        sample a 257 x 257 grid of heights over the tile; beyond the DEM, the
        ground stays at the height of its edges, not the ellipsoid's
        triangulate it to an error budget for that zoom (Delatin)
        write {z}/{x}/{y}.terrain with oct-encoded vertex normals
    write layer.json listing what's available

Heights are written as the DEM gives them, where it gives them: the filled
gaps and the level ground beyond are only for showing the site, and --surface
keeps the DEM as it is for measuring. Prints a one-line JSON summary.
"""

import argparse
import json
import math
import os
import struct
import sys
from concurrent.futures import ProcessPoolExecutor

import numpy as np
from osgeo import gdal, osr
from pydelatin import Delatin
from quantized_mesh_encoder import VertexNormalsExtension, encode

gdal.UseExceptions()

GRID = 256  # Intervals per tile side, so GRID + 1 samples.
NODATA = -32768.0
FILL_GRID = 1024  # Cells across the coarse copy that gaps are filled on.
WHOLE_ZOOM = 1  # Tiles this coarse span 90° or more, too big for the encoder's horizon culling point.
OCCLUSION_OFFSET = 64  # The horizon occlusion point in a quantized-mesh header: after the centre, heights and bounding sphere.
FAR = 1.0e6  # Earth radii out, for those tiles' culling point.
MAX_ZOOM = 20
METRES_PER_DEGREE = 111_320.0

_source = None
_edge = 0.0


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(2)


def tile_size(z: int) -> float:
    return 180.0 / 2**z


def tile_bounds(z: int, x: int, y: int) -> tuple[float, float, float, float]:
    size = tile_size(z)
    west = -180.0 + x * size
    south = -90.0 + y * size
    return west, south, west + size, south + size


def tile_range(z: int, bounds: tuple[float, float, float, float]) -> tuple[int, int, int, int]:
    """The tiles at zoom z that overlap bounds, as x0, y0, x1, y1 inclusive."""
    if z == 0:
        return 0, 0, 1, 0
    size = tile_size(z)
    west, south, east, north = bounds
    last_x, last_y = 2 ** (z + 1) - 1, 2**z - 1
    x0 = min(last_x, max(0, math.floor((west + 180.0) / size)))
    x1 = min(last_x, max(0, math.ceil((east + 180.0) / size) - 1))
    y0 = min(last_y, max(0, math.floor((south + 90.0) / size)))
    y1 = min(last_y, max(0, math.ceil((north + 90.0) / size) - 1))
    return x0, y0, x1, y1


def crs_label(wkt: str) -> str:
    reference = osr.SpatialReference(wkt=wkt)
    authority, code = reference.GetAuthorityName(None), reference.GetAuthorityCode(None)
    return f"{authority}:{code}" if authority and code else (reference.GetName() or "Custom")


def prepare(source: str, work: str, srs: str | None) -> tuple[str, tuple[float, float, float, float], float, str, tuple[float, float], float]:
    dataset = gdal.Open(source)
    if dataset.RasterCount < 1:
        fail("The file has no elevation band.")
    if srs is None and not dataset.GetProjection():
        fail("The DEM has no coordinate system. Retry with its EPSG code.")
    band = dataset.GetRasterBand(1)
    crs = srs or crs_label(dataset.GetProjection())

    geographic = os.path.join(work, "geographic.tif")
    gdal.Warp(
        geographic,
        dataset,
        format="GTiff",
        srcSRS=srs,
        dstSRS="EPSG:4326",
        srcNodata=band.GetNoDataValue(),
        dstNodata=NODATA,
        outputType=gdal.GDT_Float32,
        resampleAlg="bilinear",
        creationOptions=["TILED=YES", "COMPRESS=DEFLATE", "BIGTIFF=IF_SAFER"],
        multithread=True,
    )

    warped = gdal.Open(geographic, gdal.GA_Update)
    width, height = warped.RasterXSize, warped.RasterYSize
    band = warped.GetRasterBand(1)
    values = band.ReadAsArray()
    valid = (values != NODATA) & np.isfinite(values)
    if not valid.any():
        fail("The DEM has no heights, only no-data.")
    low, high = float(values[valid].min()), float(values[valid].max())
    edge = edge_height(values, valid)
    if not valid.all():
        fill_gaps(warped, values, valid)
    del values, valid
    band = None
    levels, factor = [], 2
    while max(width, height) // factor >= GRID:
        levels.append(factor)
        factor *= 2
    if levels:
        warped.BuildOverviews("AVERAGE", levels)

    west, res_x, _, north, _, res_y = warped.GetGeoTransform()
    bounds = (west, north + res_y * height, west + res_x * width, north)
    resolution = min(abs(res_x), abs(res_y))
    warped = None
    return geographic, bounds, resolution, crs, (low, high), edge


def fill_gaps(dataset: gdal.Dataset, values: np.ndarray, valid: np.ndarray) -> None:
    """Fills every gap, out to the corners the reprojection left empty, from
    the ground around it. Filling a coarse copy and spreading it back keeps
    this quick on a fine DEM; only the cells without data change."""
    width, height = dataset.RasterXSize, dataset.RasterYSize
    scale = max(1, math.ceil(max(width, height) / FILL_GRID))
    coarse = gdal.Warp(
        "", dataset, format="MEM", width=math.ceil(width / scale), height=math.ceil(height / scale),
        srcNodata=NODATA, dstNodata=NODATA, resampleAlg="average", outputType=gdal.GDT_Float32,
    )
    gdal.FillNodata(coarse.GetRasterBand(1), None, maxSearchDist=max(coarse.RasterXSize, coarse.RasterYSize), smoothingIterations=0)
    west, res_x, _, north, _, res_y = dataset.GetGeoTransform()
    spread = gdal.Warp(
        "", coarse, format="MEM", width=width, height=height,
        outputBounds=(west, north + res_y * height, west + res_x * width, north),
        resampleAlg="bilinear", outputType=gdal.GDT_Float32,
    )
    filled = spread.GetRasterBand(1).ReadAsArray()
    values[~valid] = filled[~valid]
    dataset.GetRasterBand(1).WriteArray(values)


def edge_height(values: np.ndarray, valid: np.ndarray) -> float:
    """The median height along the edges of the DEM's data: where the ground
    beyond it is drawn, so the site doesn't stand on a cliff down to the
    ellipsoid."""
    inner = valid.copy()
    inner[1:, :] &= valid[:-1, :]
    inner[:-1, :] &= valid[1:, :]
    inner[:, 1:] &= valid[:, :-1]
    inner[:, :-1] &= valid[:, 1:]
    inner[0, :] = inner[-1, :] = False
    inner[:, 0] = inner[:, -1] = False
    return float(np.median(values[valid & ~inner]))


def deepest_zoom(resolution: float, cap: int) -> int:
    """The zoom at which one tile's grid is about as fine as the DEM."""
    return max(0, min(cap, math.ceil(math.log2(180.0 / (GRID * resolution)))))


def open_source(path: str, edge: float) -> None:
    global _source, _edge
    _source = gdal.Open(path)
    _edge = edge


def heights(z: int, x: int, y: int) -> np.ndarray:
    west, south, east, north = tile_bounds(z, x, y)
    grid = gdal.Warp(
        "",
        _source,
        format="MEM",
        outputBounds=(west, south, east, north),
        width=GRID + 1,
        height=GRID + 1,
        srcNodata=NODATA,
        dstNodata=NODATA,
        resampleAlg="bilinear",
        outputType=gdal.GDT_Float32,
    )
    values = grid.GetRasterBand(1).ReadAsArray().astype(np.float32)
    values[(values == NODATA) | ~np.isfinite(values)] = _edge
    return values


def write_tile(job: tuple[str, int, int, int]) -> None:
    out, z, x, y = job
    values = heights(z, x, y)
    west, south, east, north = tile_bounds(z, x, y)

    # Half a grid cell, in metres, at this zoom: finer than that can't show.
    max_error = max(0.1, tile_size(z) * METRES_PER_DEGREE / GRID * 0.5)
    tin = Delatin(values, width=GRID + 1, height=GRID + 1, max_error=max_error)
    vertices, triangles = tin.vertices, tin.triangles

    positions = np.empty((len(vertices), 3), dtype=np.float64)
    # Delatin counts columns from the west and rows from the south.
    positions[:, 0] = west + vertices[:, 0] / GRID * (east - west)
    positions[:, 1] = south + vertices[:, 1] / GRID * (north - south)
    positions[:, 2] = vertices[:, 2]
    indices = triangles.astype(np.uint32).flatten()

    folder = os.path.join(out, str(z), str(x))
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, f"{y}.terrain")
    with open(path, "wb") as f:
        encode(
            f,
            positions,
            indices,
            bounds=(west, south, east, north),
            extensions=(VertexNormalsExtension(positions=positions, indices=indices),),
        )
    if z <= WHOLE_ZOOM:
        with open(path, "r+b") as f:
            f.seek(OCCLUSION_OFFSET)
            f.write(struct.pack("<3d", *occlusion_point(west, south, east, north)))


def occlusion_point(west: float, south: float, east: float, north: float) -> tuple[float, float, float]:
    """Where Cesium's horizon culling looks for a tile a quarter or half of
    the globe across, in its scaled space. No finite point bounds a tile that
    big, and the encoder's lands anywhere (behind the Earth, it culls the whole
    hemisphere): one far out over the tile's middle is seen from the tile's side
    of the globe and hidden only from the far side, where the tile is too."""
    lon, lat = math.radians((west + east) / 2), math.radians((south + north) / 2)
    return (
        FAR * math.cos(lat) * math.cos(lon),
        FAR * math.cos(lat) * math.sin(lon),
        FAR * math.sin(lat),
    )


def main() -> None:
    parser = argparse.ArgumentParser(description="Tiles a DEM as quantized-mesh terrain.")
    parser.add_argument("source")
    parser.add_argument("out")
    parser.add_argument("--srs", help="The DEM's coordinate system, when it carries none (EPSG:2193)")
    parser.add_argument("--max-zoom", type=int, default=MAX_ZOOM)
    parser.add_argument("--jobs", type=int, default=2)
    parser.add_argument("--surface", help="Also keep the heights as a GeoTIFF here, in the DEM's own coordinate system, for measuring volumes")
    args = parser.parse_args()

    os.makedirs(args.out, exist_ok=True)
    work = os.path.join(args.out, ".work")
    os.makedirs(work, exist_ok=True)

    try:
        geographic, bounds, resolution, crs, (low, high), edge = prepare(args.source, work, args.srs)
    except RuntimeError as error:
        fail(f"GDAL could not read the DEM: {error}")

    max_zoom = deepest_zoom(resolution, args.max_zoom)
    available, jobs = [], []
    for z in range(max_zoom + 1):
        x0, y0, x1, y1 = tile_range(z, bounds)
        available.append([{"startX": x0, "startY": y0, "endX": x1, "endY": y1}])
        jobs += [(args.out, z, x, y) for x in range(x0, x1 + 1) for y in range(y0, y1 + 1)]

    with ProcessPoolExecutor(max_workers=max(1, args.jobs), initializer=open_source, initargs=(geographic, edge)) as pool:
        for _ in pool.map(write_tile, jobs, chunksize=16):
            pass

    layer = {
        "tilejson": "2.1.0",
        "name": os.path.basename(args.source),
        "version": "1.0.0",
        "format": "quantized-mesh-1.0",
        "scheme": "tms",
        "tiles": ["{z}/{x}/{y}.terrain"],
        "projection": "EPSG:4326",
        "bounds": [-180, -90, 180, 90],
        "minzoom": 0,
        "maxzoom": max_zoom,
        "available": available,
        "extensions": ["octvertexnormals"],
    }
    with open(os.path.join(args.out, "layer.json"), "w") as f:
        json.dump(layer, f)

    os.remove(geographic)
    for name in os.listdir(work):
        os.remove(os.path.join(work, name))
    os.rmdir(work)

    if args.surface:
        # The heights as given, in the DEM's own grid, so volumes are measured from the survey itself.
        gdal.Translate(
            args.surface, args.source, format="GTiff", bandList=[1], outputSRS=args.srs,
            outputType=gdal.GDT_Float32,
            creationOptions=["TILED=YES", "COMPRESS=DEFLATE", "PREDICTOR=3", "BIGTIFF=IF_SAFER"],
        )

    print(json.dumps({
        "crs": crs,
        "tiles": len(jobs),
        "maxZoom": max_zoom,
        "bounds": [round(b, 7) for b in bounds],
        "heights": [round(low, 2), round(high, 2)],
    }))


if __name__ == "__main__":
    main()

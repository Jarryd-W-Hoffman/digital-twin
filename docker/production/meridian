#!/usr/bin/env bash
# Runs Meridian in production on one server with Docker. See
# docs/manual/23-deploying.md.
#
#   meridian install [domain] [email]   write .env with new secrets, build, start
#   meridian start | stop | status | logs [service]
#   meridian upgrade                    back up, pull, rebuild, migrate, restart
#   meridian backup                     the database, uploads and .env, to backups/
#   meridian restore <backup folder>    put a backup back (replaces what's there)
#   meridian artisan <command…>         run an artisan command in the app
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
env_file="$here/.env"
profiles=()

compose() {
    docker compose -f "$here/compose.yml" --env-file "$env_file" "${profiles[@]}" "$@"
}

say() { printf '\033[1;33m%s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

need_env() {
    [ -f "$env_file" ] || fail "No $env_file yet. Run: $0 install"
    # The optional parts this server runs, from .env.
    profiles=()
    if grep -q '^MERIDIAN_MQTT_AUTH_SECRET=..*' "$env_file" && grep -q '^MERIDIAN_RUN_MQTT=true' "$env_file"; then
        profiles+=(--profile mqtt)
    fi
    if grep -q '^MERIDIAN_GATEWAY_TOKEN=..*' "$env_file"; then
        profiles+=(--profile gateway)
    fi
    if grep -q '^MERIDIAN_NODEODM_URL=http://nodeodm:' "$env_file"; then
        profiles+=(--profile photos)
    fi
}

secret() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

set_env() {
    local key="$1" value="$2"
    if grep -q "^${key}=" "$env_file"; then
        sed -i.bak "s|^${key}=.*|${key}=${value}|" "$env_file" && rm -f "$env_file.bak"
    else
        printf '%s=%s\n' "$key" "$value" >>"$env_file"
    fi
}

build() {
    say "Building the images (the first time takes a while: the converter's tools are large)…"
    compose --profile build build converter-tools
    compose build
}

install() {
    command -v docker >/dev/null || fail "Docker isn't installed. See https://docs.docker.com/engine/install/"
    docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 isn't installed."

    if [ -f "$env_file" ]; then
        say "$env_file already exists; keeping it."
    else
        local domain="${1:-}" email="${2:-}"
        [ -n "$domain" ] || read -rp "Domain people will use (its DNS pointing at this server): " domain
        [ -n "$email" ] || read -rp "Email for Let's Encrypt and as the sender address: " email
        [ -n "$domain" ] || fail "A domain is needed."

        cp "$here/.env.example" "$env_file"
        chmod 600 "$env_file"
        set_env MERIDIAN_DOMAIN "$domain"
        set_env APP_URL "https://$domain"
        set_env ACME_EMAIL "$email"
        set_env MAIL_FROM_ADDRESS "$email"
        set_env MERIDIAN_MQTT_BROKER_URL "mqtts://$domain:8883"
        set_env APP_KEY "base64:$(head -c 32 /dev/urandom | base64)"
        set_env DB_PASSWORD "$(secret 24)"
        set_env MERIDIAN_MQTT_AUTH_SECRET "$(secret 24)"
        # Ports given in the environment, for a server where 80 and 443 are taken.
        local port
        for port in HTTP_PORT HTTPS_PORT MQTT_PORT MERIDIAN_RUN_MQTT; do
            if [ -n "${!port:-}" ]; then set_env "$port" "${!port}"; fi
        done
        if [ -n "${MQTT_PORT:-}" ]; then set_env MERIDIAN_MQTT_BROKER_URL "mqtts://$domain:$MQTT_PORT"; fi
        say "Wrote $env_file with new secrets. Keep a copy somewhere safe: the app key decrypts stored secrets."
    fi

    need_env
    build
    say "Starting Meridian…"
    compose up -d
    local domain
    domain="$(grep '^MERIDIAN_DOMAIN=' "$env_file" | cut -d= -f2-)"
    say "Meridian is starting at https://$domain"
    echo "Open it and choose Get started to make the first account and organisation."
    echo "Emails go to the app's log ($0 logs app) until MAIL_MAILER=smtp and the MAIL_* settings are set in $env_file (then: $0 start)."
}

backup() {
    need_env
    local dir
    dir="$root/backups/$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$dir"
    say "Backing up to $dir…"
    # shellcheck disable=SC2016 # expanded by the container's shell
    compose exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' >"$dir/database.dump"
    compose exec -T app tar czf - -C /var/www/html/storage app >"$dir/uploads.tar.gz"
    cp "$env_file" "$dir/env"
    chmod 600 "$dir/env"
    say "Done: $(du -sh "$dir" | cut -f1). Copy it off this server too."
}

restore() {
    need_env
    local dir="${1:-}"
    [ -n "$dir" ] && [ -f "$dir/database.dump" ] && [ -f "$dir/uploads.tar.gz" ] ||
        fail "Give a backup folder with database.dump and uploads.tar.gz."
    read -rp "This replaces the database and uploads with the backup's. Type 'restore' to go on: " sure
    [ "$sure" = restore ] || fail "Nothing changed."
    # Everything but the database and Redis stops, and starts again however
    # the restore goes.
    compose stop web app worker scheduler converter mosquitto gateway
    trap 'compose up -d' EXIT

    # TimescaleDB's way: a fresh database, then the dump between
    # timescaledb_pre_restore() and timescaledb_post_restore().
    say "Restoring the database…"
    # shellcheck disable=SC2016 # expanded by the container's shell
    compose exec -T postgres sh -c '
        set -e
        psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres \
            -c "DROP DATABASE IF EXISTS \"$POSTGRES_DB\" WITH (FORCE)" \
            -c "CREATE DATABASE \"$POSTGRES_DB\""
        psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
            -c "CREATE EXTENSION IF NOT EXISTS timescaledb" \
            -c "SELECT timescaledb_pre_restore()" >/dev/null
        pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner 2>/tmp/restore.log || true
        psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
            -c "SELECT timescaledb_post_restore()" >/dev/null
        if grep -v "extension \"timescaledb\" already exists\|errors ignored on restore\|could not execute query: ERROR:  extension" /tmp/restore.log | grep -q "error:"; then
            cat /tmp/restore.log >&2
            exit 1
        fi
    ' <"$dir/database.dump"

    say "Restoring the uploads…"
    compose run --rm --no-deps --entrypoint sh app -c 'rm -rf /var/www/html/storage/app && tar xzf - -C /var/www/html/storage' <"$dir/uploads.tar.gz"
    say "Restored from $dir."
}

upgrade() {
    need_env
    backup
    if git -C "$root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        say "Pulling the latest code…"
        git -C "$root" pull --ff-only
    else
        say "No upstream branch to pull from; building the code as it is."
    fi
    build
    say "Restarting (migrations run first)…"
    compose up -d --remove-orphans
    say "Upgraded. Check the CHANGELOG for anything to do by hand."
}

command="${1:-help}"
shift || true
case "$command" in
    install) install "$@" ;;
    start) need_env; compose up -d ;;
    stop) need_env; compose stop ;;
    status) need_env; compose ps ;;
    logs) need_env; compose logs -f --tail=100 "$@" ;;
    upgrade) upgrade ;;
    backup) backup ;;
    restore) restore "$@" ;;
    artisan) need_env; compose exec app php artisan "$@" ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
esac

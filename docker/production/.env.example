# Meridian's production settings: read by docker/production/compose.yml and
# by the app. `docker/production/meridian install` writes this file as .env,
# with the secrets generated. Every app setting is in the README's
# Configuration section.

# Where people reach Meridian. Point the domain's DNS at this server first:
# Caddy gets its HTTPS certificate from Let's Encrypt on first start.
MERIDIAN_DOMAIN=twins.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://twins.example.com

APP_NAME=Meridian
APP_ENV=production
APP_DEBUG=false
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Email for invitations, password resets and alert channels. Until a mail
# server is set, emails are written to the app's log (`meridian logs app`)
# instead of sent; set MAIL_MAILER=smtp with the server's details to send them.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=meridian@example.com
MAIL_FROM_NAME=Meridian

# Uploads are kept on the storage volume. For object storage instead (S3,
# Cloudflare R2, Backblaze B2, MinIO), set MERIDIAN_ASSETS_DISK=s3 and the
# AWS_* settings, and MERIDIAN_DIRECT_UPLOADS=true for uploads over 512 MB.
MERIDIAN_ASSETS_DISK=local

# The MQTT broker, for devices that publish readings: true to run it.
# Devices connect over TLS on MQTT_PORT, with the domain's certificate.
MERIDIAN_RUN_MQTT=false
MERIDIAN_MQTT_AUTH_SECRET=
MERIDIAN_MQTT_BROKER_URL=mqtts://twins.example.com:8883

# A gateway beside the control plane (`--profile gateway`): a token from a
# twin's Gateway section.
MERIDIAN_GATEWAY_TOKEN=

# The ports published on this server.
HTTP_PORT=80
HTTPS_PORT=443
MQTT_PORT=8883
